{
  "expo": {
    "name": "Wattly",
    "slug": "wattly",
    "owner": "argoren",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.wattly.mobile",
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.wattly.mobile",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-updates",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Wattly używa aparatu tylko do skanowania numeru PPE z faktury lub licznika.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "scheme": "wattly",
    "extra": {
      "apiUrl": "http://localhost:5103",
      "eas": {
        "projectId": "0d60d8dc-6f78-4d20-b6b7-06fb922750b9"
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
